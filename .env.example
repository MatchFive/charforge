# 复制为 .env 并填写。.env 已在 .gitignore 中，不会入库。

# ── 生成后端 ──────────────────────────────────────────────
# local | cloud | mock
# mock = 用占位图跑通全链路（无需 GPU、无需 API key）
CHARFORGE_BACKEND=mock

# ── 本地链路（backend=local）────────────────────────────
SD_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
SD_CONTROLNET_OPENPOSE=lllyasviel/control_v11p_sd15_openpose
SD_DEVICE=cuda            # cuda | cpu | mps
SD_DTYPE=float16          # float16 | bfloat16 | float32

# ComfyUI（可选：走 ComfyUI API 而不是 diffusers 直调）
COMFYUI_URL=

# ── 云端链路（backend=cloud）────────────────────────────
# 你的 key 只留在本机，绝不入库
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ── 风格锁定 ─────────────────────────────────────────────
# master reference 的默认存放位置（人造确认后的定稿风格图）
STYLE_MASTER_DIR=./configs/style_masters
CLIP_MODEL_ID=openai/clip-vit-large-patch14
STYLE_SIMILARITY_THRESHOLD=0.85

# ── 输出与配额 ───────────────────────────────────────────
OUTPUT_DIR=./out
MAX_FRAMES_PER_JOB=32
MAX_JOBS_PER_HOUR=20

# ── 服务端 ───────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
