{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "UNet加载器（7B 单流 DiT）"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "_meta": {
      "title": "加载CLIP（Qwen3-VL 8B 文本编码器）"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {
      "title": "加载VAE（64 通道 RGBA）"
    }
  },
  "4": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "1:1 (Square)",
      "megapixels": 1,
      "multiple": 8
    },
    "_meta": {
      "title": "分辨率选择器（1:1 / 1 MP → 1024×1024）"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": ["4", 0],
      "height": ["4", 1],
      "batch_size": 1
    },
    "_meta": {
      "title": "空Latent图像"
    }
  },
  "6": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "prompt": "This is an RGBA image with transparency. The image has alpha channel and the background is transparent. 华丽精致的半写实厚涂画风的2D游戏角色立绘：光影层次细腻，体积感与材质感明确（布料、皮革、金属、木料各自成色），服饰纹样与随身饰件细节丰富，轮廓带边缘光，整体华丽而有层次；不要扁平色块，不要写实照片质感。一位身着素雅青灰长衫的博物馆讲解员，手持讲解册，神态温和。全身立绘，正面站立。无背景，无地面，无投影，脚下是看不见的地面。",
      "negative_prompt": "",
      "resolution": 1024,
      "clip": ["2", 0]
    },
    "_meta": {
      "title": "文本编码 Qwen Image 2.1"
    }
  },
  "7": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "device": "auto",
      "dtype": "default",
      "model": ["1", 0]
    },
    "_meta": {
      "title": "Qwen Image 2.1 缓存"
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 12345,
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["7", 0],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["5", 0]
    },
    "_meta": {
      "title": "K采样器"
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    },
    "_meta": {
      "title": "VAE解码"
    }
  },
  "10": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "filename_prefix": "charforge/qwen21",
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB",
      "images": ["9", 0]
    },
    "_meta": {
      "title": "保存图像（高级，必须 PNG 才留得住 alpha）"
    }
  }
}
