/* CharForge 编辑器窗口样式。
 *
 * 刻意不写死颜色：Unity 的浅色 / 深色皮肤由编辑器主题决定，
 * 硬编码深色背景会让浅色皮肤下的文字看不见。这里只用布局、间距与
 * 半透明底色 —— 两种主题下都成立。
 */

.cf-root {
    flex-grow: 1;
    padding: 8px;
}

.cf-header {
    margin-bottom: 6px;
}

.cf-title {
    -unity-font-style: bold;
    font-size: 14px;
}

.cf-subtitle {
    font-size: 11px;
    opacity: 0.75;
    white-space: normal;
    margin-top: 2px;
}

.cf-body {
    flex-grow: 1;
    min-height: 180px;
}

.cf-section {
    margin-bottom: 6px;
}

.cf-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.cf-actions > Button {
    margin-right: 6px;
    margin-bottom: 4px;
    min-width: 120px;
}

.cf-primary {
    -unity-font-style: bold;
}

.cf-footer {
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
    padding-top: 6px;
}

.cf-next-action {
    font-size: 11px;
    white-space: normal;
    margin-top: 4px;
    opacity: 0.85;
}

.cf-log-title {
    -unity-font-style: bold;
    margin-top: 6px;
    font-size: 11px;
}

.cf-log {
    min-height: 90px;
    max-height: 200px;
    background-color: rgba(128, 128, 128, 0.10);
    padding: 4px;
}

.cf-log-label {
    font-size: 10px;
    white-space: normal;
}

.cf-badge {
    font-size: 10px;
    padding: 2px 6px;
    margin-bottom: 4px;
    white-space: normal;
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.6);
    padding-left: 6px;
}

.cf-field {
    margin-bottom: 3px;
}
